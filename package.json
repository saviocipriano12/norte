{
  "name": "norte",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.1",
    "@expo/metro-runtime": "^57.0.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "^2.110.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "expo": "~57.0.1",
    "expo-dev-client": "~57.0.9",
    "expo-font": "~57.0.1",
    "expo-linear-gradient": "^57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.1",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "openai": "^6.45.0",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.0",
    "react-native-reanimated": "4.5.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.2",
    "react-native-webrtc": "^124.0.8",
    "react-native-worklets": "^0.10.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.0.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.1",
    "concurrently": "^10.0.3",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@config-plugins/react-native-webrtc": {
      "expo": "$expo"
    }
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm run dev:server\" \"npm run web\"",
    "dev:web": "concurrently -k -n api,web -c yellow,cyan \"npm run dev:server\" \"npm run web\"",
    "dev:native": "concurrently -k -n api,app -c yellow,cyan \"npm run dev:server\" \"npm start\"",
    "start": "node scripts/start-expo.mjs native",
    "android": "node scripts/start-expo.mjs android",
    "ios": "node scripts/start-expo.mjs ios",
    "web": "node scripts/start-expo.mjs web",
    "android:build": "expo run:android",
    "ios:build": "expo run:ios",
    "server": "tsx server/bootstrap.ts",
    "dev:server": "tsx watch server/bootstrap.ts",
    "test": "node --import tsx scripts/test-finance.mjs",
    "typecheck": "tsc --noEmit"
  },
  "private": true
}
